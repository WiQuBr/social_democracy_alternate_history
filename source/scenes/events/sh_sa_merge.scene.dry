on-arrival: stahlhelm_sa_seen = 1; sa_militancy = (sa_militancy * (sa_strength / (sa_strength + sh_strength))) + (sh_militancy * (sh_strength / (sa_strength + sh_strength))); sa_strength = sa_strength + sh_strength; sh_strength = 0; sh_militancy = 0;
